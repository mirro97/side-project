# 공식 브롤스타즈 API 키 — 필수
#
# https://developer.brawlstars.com 에서 발급한다.
# 키에 IP 화이트리스트가 걸리므로, RoyaleAPI 프록시를 쓰려면
# 발급 시 45.79.218.79 를 등록해야 한다 (기본 베이스 URL 이 그 프록시다).
BRAWL_STARS_TOKEN=

# Gemini API 키 — 선택
#
# `npm run build:ai` 로 AI 설명을 직접 생성할 때만 필요하다.
# 앱 실행에는 필요 없다 — 생성물은 레포에 커밋돼 있고,
# AI 채팅은 사용자가 자기 키를 브라우저에 넣는 방식(BYOK)이다.
GEMINI_API_KEY=
